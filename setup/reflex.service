[Unit]
Description=Reflex UI Service (Standalone)
After=network.target chromadb.service postgresql.service
Wants=chromadb.service

[Service]
Type=simple
User=jayeondeule
Group=jayeondeule
WorkingDirectory=/workspace/jayeondeule

ExecStart=/workspace/jayeondeule/agri_ai_core/run_reflex.sh

EnvironmentFile=/workspace/jayeondeule/.env

# Standalone 모드 (백그라운드 서비스 포함)
Environment="STANDALONE=true"

Restart=always
RestartSec=10

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=reflex

[Install]
WantedBy=multi-user.target
