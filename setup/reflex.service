[Unit]
Description=Reflex UI Service (UI-only)
After=network.target chromadb.service postgresql.service
Wants=chromadb.service
Conflicts=agriAiCore.service

[Service]
Type=simple
User=jayeondeule
Group=jayeondeule
WorkingDirectory=/workspace/jayeondeule

ExecStart=/workspace/jayeondeule/agri_ai_core/run_reflex.sh

EnvironmentFile=/workspace/jayeondeule/.env

# UI-only 모드 (스케줄러/백그라운드 서비스는 agriAiCore에서 관리)
Environment="STANDALONE=false"

Restart=always
RestartSec=10

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=reflex

[Install]
WantedBy=multi-user.target
