[Unit]
Description=AgriAI Core Services (Scheduler + Reflex UI)
After=network.target chromadb.service postgresql.service
Wants=chromadb.service
Conflicts=reflex.service

[Service]
Type=simple
User=jayeondeule
Group=jayeondeule
WorkingDirectory=/workspace/jayeondeule

# 통합 실행 스크립트 사용
ExecStart=/workspace/jayeondeule/setup/run_services.sh

# 환경 변수 로드
EnvironmentFile=/workspace/jayeondeule/.env

# 재시작 정책
Restart=always
RestartSec=10

# 프로세스 종료 설정
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# 로그 출력
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agriAiCore

[Install]
WantedBy=multi-user.target
