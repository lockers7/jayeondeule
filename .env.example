# =========================================================================
# AgriAI Core 환경 변수 예시
# =========================================================================

# ------------------------------------------------------------
# Reflex UI
# ------------------------------------------------------------
REFLEX_ENV=prod
REFLEX_PUBLIC_HOST=your-domain.example.com
REFLEX_PUBLIC_PORT=3000

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
PGDB_HOST=127.0.0.1
PGDB_PORT=5432
PGDB_DATABASE=your_database
PGDB_USER=your_username
PGDB_PASSWORD=your_password

# ------------------------------------------------------------
# ChromaDB
# ------------------------------------------------------------
CLIENT_TYPE=http
CHROMA_DB_IMPL=sqlite
CHROMADB_BACKEND=sqlite
CHROMA_DB_PATH=/data/chroma.sqlite3
CHROMA_DB_HTTP_HOST=127.0.0.1
CHROMA_DB_HTTP_PORT=8000
VECTOR_DB=/workspace/llm/chromadb/database/
VECTOR_CACHE=/workspace/llm/chromadb/cache/

COLLECTION_FARM=farm_collection
COLLECTION_SOURCE=source_collection
COLLECTION_STATS=stats_collection
COLLECTION_OPTIMAL=optimal_collection
COLLECTION_LEARNED=learned_collection
COLLECTION_SETTING=setting_collection
COLLECTION_DOCS_LEARNED=document_collection
COLLECTION_LAST_LEARNED=last_learned_date
COLLECTION_SELF_LEARNED=self_supervised_learning
COLLECTION_PATTERN_LEARNED=self_pattern_learning

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_PATH=/workspace/jayeondeule/logs
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Ollama / Model
# ------------------------------------------------------------
MODEL_NAME=qwen3:14b
MODEL_PREFIX=qwen
UNITS_NAME=자연들에
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL_NAME=mxbai-embed-large:latest

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------
PYTHONPATH=.
AGRI_AI_CORE_EXPERIMENTAL_API=1
AGRI_AI_CORE_EXPERIMENTAL_UI=1
