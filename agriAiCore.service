[Unit]
Description=AgriAI Core Services (FastAPI + Streamlit)
After=network.target docker.service postgresql.service
Wants=docker.service

[Service]
Type=simple
User=jayeondeule
Group=jayeondeule
WorkingDirectory=/workspace/jayeondeule

# 통합 실행 스크립트 사용
ExecStart=/workspace/jayeondeule/run_services.sh

# 환경 변수 로드
EnvironmentFile=/workspace/jayeondeule/.env
Environment="PYTHONDONTWRITEBYTECODE=1"

# 재시작 정책
Restart=always
RestartSec=10

# 프로세스 종료 설정
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# 로그 출력
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agriAiCore

[Install]
WantedBy=multi-user.target
