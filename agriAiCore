# --- Shop Spring Boot (port 9091) ---
SHOP_PID="$PID_DIR/shop.pid"

shop_start() {
    if [ -f "$SHOP_PID" ] && [ -d "/proc/$(cat "$SHOP_PID" 2>/dev/null)" ]; then
        log_msg "${YELLOW}[Shop Backend]${NC} 이미 실행 중 (PID $(cat "$SHOP_PID"))"
        return 0
    fi
    log_msg "${BLUE}[Shop Backend]${NC} 시작 중 (port 9091)..."
    cd "$BASE_DIR/shop/backend" || return 1
    nohup java -jar target/shop-0.0.1-SNAPSHOT.jar > "$LOG_DIR/shop_backend.log" 2>&1 &
    echo $! > "$SHOP_PID"
    cd "$BASE_DIR"
    if wait_port 9091 30; then
        log_msg "${GREEN}[Shop Backend]${NC} 시작 완료 (port 9091, PID $(cat "$SHOP_PID"))"
    else
        log_msg "${RED}[Shop Backend]${NC} 시작 실패"
        return 1
    fi
}

shop_stop() {
    log_msg "${BLUE}[Shop Backend]${NC} 종료 중..."
    if [ -f "$SHOP_PID" ]; then
        local pid
        pid=$(cat "$SHOP_PID" 2>/dev/null)
        if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
            kill "$pid" 2>/dev/null
            sleep 2
            # 강제 종료
            [ -d "/proc/$pid" ] && kill -9 "$pid" 2>/dev/null
        fi
        rm -f "$SHOP_PID"
    fi
    log_msg "${GREEN}[Shop Backend]${NC} 종료 완료"
}

shop_restart() {
    log_msg "${BLUE}[Shop Backend]${NC} 빌드 중..."
    cd "$BASE_DIR/shop/backend" || return 1
    mvn package -DskipTests -q > "$LOG_DIR/shop_build.log" 2>&1
    if [ $? -ne 0 ]; then
        log_msg "${RED}[Shop Backend]${NC} 빌드 실패 — $LOG_DIR/shop_build.log 확인"
        cd "$BASE_DIR"
        return 1
    fi
    log_msg "${GREEN}[Shop Backend]${NC} 빌드 완료"
    cd "$BASE_DIR"

    shop_stop
    shop_start
}

shop_build() {
    local failed=0
    log_msg "${BOLD}========== Shop 빌드 시작 ==========${NC}"

    # 1) Shop React 프론트엔드 빌드
    log_msg "${BLUE}[Shop React]${NC} 프론트엔드 빌드 시작..."
    cd "$BASE_DIR/shop/frontend"
    npm run build >> "$LOG_DIR/shop_react_build.log" 2>&1
    if [ $? -eq 0 ]; then
        log_msg "${GREEN}[Shop React]${NC} 프론트엔드 빌드 완료"
    else
        log_msg "${RED}[Shop React]${NC} 프론트엔드 빌드 실패 (로그: $LOG_DIR/shop_react_build.log)"
        failed=1
    fi

    # 2) Shop Spring Boot 백엔드 빌드
    log_msg "${BLUE}[Shop Backend]${NC} 백엔드 빌드 시작..."
    cd "$BASE_DIR/shop/backend"
    mvn package -DskipTests -q >> "$LOG_DIR/shop_build.log" 2>&1
    if [ $? -eq 0 ]; then
        log_msg "${GREEN}[Shop Backend]${NC} 백엔드 빌드 완료"
    else
        log_msg "${RED}[Shop Backend]${NC} 백엔드 빌드 실패 (로그: $LOG_DIR/shop_build.log)"
        failed=1
    fi

