#!/bin/bash
# =========================================================================
# agriAiCore - AgriAI Core 통합 서비스 관리 스크립트
#
# 사용법:
#   agriAiCore {start|stop|restart|status|logs|enable|disable} [서비스번호]
#
# 서비스번호 없이 start/stop/restart 실행 시 대화형 메뉴를 표시합니다.
# =========================================================================

set -o pipefail

# ─── 기본 설정 ───
BASE_DIR="/workspace/jayeondeule"
VENV_BIN="$BASE_DIR/venv/bin"
PYTHON_BIN="$VENV_BIN/python"
LOG_DIR="${LOG_PATH:-$BASE_DIR/logs}"
ENV_FILE="$BASE_DIR/.env"
CORE_SERVICE="agriAiCore.service"

# PID 파일 (프로젝트 logs 디렉토리 사용 — /tmp는 root 소유 파일 충돌 가능)
PID_DIR="$BASE_DIR/logs"
mkdir -p "$PID_DIR"
API_PID="$PID_DIR/api.pid"
SCHEDULER_PID="$PID_DIR/scheduler.pid"
AGENT_PID="$PID_DIR/agent_monitor.pid"  # Agent Monitor (Phase 2, 16번)
AGENT_WORKER_PID="$PID_DIR/agent_pending_worker.pid"  # Agent Pending Worker (Phase 3, 17번)

# 색상 정의
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# .env 로드
if [ -f "$ENV_FILE" ]; then
    set -a
    . "$ENV_FILE"
    set +a
fi

# ─── 유틸리티 함수 ───
log_msg() {
    local ts
    ts="$(date '+%Y-%m-%d %H:%M:%S')"
    echo -e "[$ts] $*"
}

print_header() {
    echo ""
    echo -e "${CYAN}╔═════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}  ${BOLD}AgriAI Core 통합 서비스 관리${NC}   ${CYAN}║${NC}"
    echo -e "${CYAN}╚═════════════════════════════════╝${NC}"
    echo ""
}

is_port_listening() {
    local port_hex
    port_hex=$(printf '%04X' "$1")
    awk -v p="$port_hex" '
        NR > 1 {
            split($2, addr, ":")
            if (toupper(addr[2]) == p && $4 == "0A") { found = 1; exit 0 }
        }
        END { if (!found) exit 1 }
    ' /proc/net/tcp /proc/net/tcp6 2>/dev/null
}

check_status() {
    local name="$1" check_type="$2" target="$3"
    case "$check_type" in
        port)
            if is_port_listening "$target"; then
                echo -e "${GREEN}● 실행 중${NC} (port $target)"
            else
                echo -e "${RED}○ 중지${NC}"
            fi
            ;;
        pid_file)
            if [ -f "$target" ]; then
                local pid
                pid=$(cat "$target" 2>/dev/null)
                if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
                    echo -e "${GREEN}● 실행 중${NC} (PID $pid)"
                else
                    echo -e "${RED}○ 중지${NC} (stale PID)"
                fi
            else
                echo -e "${RED}○ 중지${NC}"
            fi
            ;;
        systemd)
            if systemctl is-active "$target" >/dev/null 2>&1; then
                echo -e "${GREEN}● 실행 중${NC} (systemd)"
            else
                echo -e "${RED}○ 중지${NC}"
            fi
            ;;
        process)
            if pgrep -f "$target" >/dev/null 2>&1; then
                local pid
                pid=$(pgrep -f "$target" | head -1)
                echo -e "${GREEN}● 실행 중${NC} (PID $pid)"
            else
                echo -e "${RED}○ 중지${NC}"
            fi
            ;;
    esac
}

wait_port() {
    local port="$1" timeout="${2:-30}" waited=0
    while [ "$waited" -lt "$timeout" ]; do
        if is_port_listening "$port"; then
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done
    return 1
}

# 프로세스 안전 종료 (권한 부족 시 sudo 에스컬레이션)
_safe_kill() {
    local pid="$1" name="${2:-프로세스}"
    if [ -z "$pid" ] || [ ! -d "/proc/$pid" ]; then
        return 0  # 이미 종료됨
    fi

    # 1차: 일반 kill
    kill "$pid" 2>/dev/null
    sleep 2
    [ ! -d "/proc/$pid" ] && return 0

    # 2차: 일반 kill -9
    kill -9 "$pid" 2>/dev/null
    sleep 1
    [ ! -d "/proc/$pid" ] && return 0

    # 3차: sudo kill (권한 부족 시)
    log_msg "${YELLOW}[$name]${NC} 권한 부족 → sudo kill 시도 (PID $pid)"
    sudo kill "$pid" 2>/dev/null
    sleep 2
    [ ! -d "/proc/$pid" ] && return 0

    # 4차: sudo kill -9
    sudo kill -9 "$pid" 2>/dev/null
    sleep 1
    [ ! -d "/proc/$pid" ] && return 0

    # 종료 실패
    log_msg "${RED}[$name]${NC} PID $pid 종료 실패"
    return 1
}

