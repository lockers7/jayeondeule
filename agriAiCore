#!/bin/bash
# -*- coding: utf-8 -*-
# =========================================================================
# AgriAI Core 시스템 제어 스크립트
# Usage: agriAiCore {start|stop|restart|status|logs}
# =========================================================================

set -e

# 색상 정의
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 서비스명
SERVICE_NAME="agriAiCore.service"

# -------------------------------------------------------------------
# 도움말
# -------------------------------------------------------------------
show_help() {
    echo -e "${BLUE}=========================================="
    echo "  AgriAI Core 시스템 제어"
    echo -e "==========================================${NC}"
    echo ""
    echo "사용법: agriAiCore {command}"
    echo ""
    echo "명령어:"
    echo "  start       - 시스템 시작"
    echo "  stop        - 시스템 중지"
    echo "  restart     - 시스템 재시작"
    echo "  status      - 시스템 상태 확인"
    echo "  logs        - 실시간 로그 확인"
    echo "  help        - 도움말 표시"
    echo ""
    echo "예제:"
    echo "  agriAiCore start"
    echo "  agriAiCore status"
    echo "  agriAiCore logs"
    echo ""
}

# -------------------------------------------------------------------
# 시스템 시작
# -------------------------------------------------------------------
start_system() {
    echo -e "${GREEN}AgriAI Core 시스템 시작 중...${NC}"
    sudo systemctl start "$SERVICE_NAME"
    sleep 2

    if sudo systemctl is-active --quiet "$SERVICE_NAME"; then
        echo -e "${GREEN}✓ 시스템이 정상적으로 시작되었습니다${NC}"
        echo ""
        echo "접속 정보:"
        echo "  - FastAPI API: http://localhost:8088"
        echo "  - API 문서: http://localhost:8088/docs"
        echo "  - Streamlit UI: http://localhost:8501"
        echo ""
        echo "상태 확인: agriAiCore status"
        echo "로그 확인: agriAiCore logs"
    else
        echo -e "${RED}✗ 시스템 시작 실패${NC}"
        echo "상태 확인: agriAiCore status"
        exit 1
    fi
}

# -------------------------------------------------------------------
# 시스템 중지
# -------------------------------------------------------------------
stop_system() {
    echo -e "${YELLOW}AgriAI Core 시스템 중지 중...${NC}"
    sudo systemctl stop "$SERVICE_NAME"
    sleep 2

    if ! sudo systemctl is-active --quiet "$SERVICE_NAME"; then
        echo -e "${GREEN}✓ 시스템이 정상적으로 중지되었습니다${NC}"
    else
        echo -e "${RED}✗ 시스템 중지 실패${NC}"
        exit 1
    fi
}

# -------------------------------------------------------------------
# 시스템 재시작
# -------------------------------------------------------------------
restart_system() {
    echo -e "${YELLOW}AgriAI Core 시스템 재시작 중...${NC}"
    sudo systemctl restart "$SERVICE_NAME"
    sleep 2

    if sudo systemctl is-active --quiet "$SERVICE_NAME"; then
        echo -e "${GREEN}✓ 시스템이 정상적으로 재시작되었습니다${NC}"
        echo ""
        echo "접속 정보:"
        echo "  - FastAPI API: http://localhost:8088"
        echo "  - API 문서: http://localhost:8088/docs"
        echo "  - Streamlit UI: http://localhost:8501"
    else
        echo -e "${RED}✗ 시스템 재시작 실패${NC}"
        exit 1
    fi
}

# -------------------------------------------------------------------
# 시스템 상태 확인
# -------------------------------------------------------------------
show_status() {
    echo -e "${BLUE}=========================================="
    echo "  AgriAI Core 시스템 상태"
    echo -e "==========================================${NC}"
    echo ""
    sudo systemctl status "$SERVICE_NAME" --no-pager
    echo ""
    echo "포트 상태:"
    netstat -tuln | grep -E "8088|8501" || echo "  포트가 열려있지 않습니다"
    echo ""
}

# -------------------------------------------------------------------
# 로그 확인
# -------------------------------------------------------------------
show_logs() {
    echo -e "${BLUE}=========================================="
    echo "  AgriAI Core 실시간 로그"
    echo -e "==========================================${NC}"
    echo ""
    echo "Ctrl+C로 종료"
    echo ""
    sudo journalctl -u "$SERVICE_NAME" -f
}

# -------------------------------------------------------------------
# 메인 실행
# -------------------------------------------------------------------
case "${1:-}" in
    start)
        start_system
        ;;
    stop)
        stop_system
        ;;
    restart)
        restart_system
        ;;
    status)
        show_status
        ;;
    logs)
        show_logs
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo -e "${RED}오류: 알 수 없는 명령어 '$1'${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac
