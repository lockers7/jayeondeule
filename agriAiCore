camera_archive_disk_usage() {
    local root="${UPLOAD_PATH:-/workspace/jayeondeule/upload}/camera"
    log_msg "${BLUE}[카메라아카이브]${NC} 저장소: $root"
    if [ ! -d "$root" ]; then
        log_msg "  (디렉토리 없음 — 캡처 미실행)"
        return 0
    fi
    du -sh "$root" 2>/dev/null | sed 's/^/  전체  /'
    find "$root" -mindepth 2 -maxdepth 2 -type d 2>/dev/null | while read -r d; do
        local count size
        count=$(find "$d" -name '*.jpg' 2>/dev/null | wc -l)
        size=$(du -sh "$d" 2>/dev/null | awk '{print $1}')
        printf "  %-40s %5d장  %s\n" "${d#$root/}" "$count" "$size"
    done
}


