#!/bin/bash
# -*- coding: utf-8 -*-
# =========================================================================
# AgriAI Core 통합 시스템 제어 스크립트
# 실제 서비스 관리는 setup/agriCoreCtrl.sh에 위임합니다.
#
# Usage: agriAiCore {start|stop|restart|status|logs|enable|disable}
# =========================================================================

# 색상 정의
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# 프로젝트 경로
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CTRL_SCRIPT="$SCRIPT_DIR/setup/agriCoreCtrl.sh"
CORE_SERVICE="agriAiCore.service"

# agriCoreCtrl.sh 존재 확인
if [ ! -f "$CTRL_SCRIPT" ]; then
    echo -e "${RED}오류: $CTRL_SCRIPT 파일을 찾을 수 없습니다${NC}"
    exit 1
fi

# -------------------------------------------------------------------
# 도움말
# -------------------------------------------------------------------
show_help() {
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}  ${BOLD}AgriAI Core 통합 시스템 제어${NC}                             ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo "사용법: agriAiCore {command}"
    echo ""
    echo "명령어:"
    echo "  start       - 전체 서비스 시작"
    echo "  stop        - 전체 서비스 중지"
    echo "  restart     - 전체 서비스 재시작"
    echo "  status      - 전체 서비스 상태 확인"
    echo "  logs        - 실시간 로그 확인"
    echo "  enable      - 시스템 부팅 시 자동 시작 활성화"
    echo "  disable     - 시스템 부팅 시 자동 시작 비활성화"
    echo "  help        - 도움말 표시"
    echo ""
    echo "관리 서비스:"
    echo "  1. Ollama          (LLM 서버,       port 11434)"
    echo "  2. PostgreSQL      (관계형 DB,      port 5432)"
    echo "  3. ChromaDB        (벡터 DB,        port 8000)"
    echo "  4. Scheduler       (스케줄/환경제어)"
    echo "  5. FastAPI         (REST API,       port 8002)"
    echo "  6. SearXNG         (메타검색엔진,    port 8888)"
    echo "  7. Spring Boot     (웹 백엔드,       port 9090)"
    echo "  8. Nginx           (웹서버,          port 80)"
    echo ""
    echo "세부 서비스 관리: agriCoreCtrl (setup/agriCoreCtrl.sh)"
    echo ""
}

# -------------------------------------------------------------------
# 메인 실행
# -------------------------------------------------------------------
case "${1:-}" in
    start)
        "$CTRL_SCRIPT" start 0
        ;;
    stop)
        "$CTRL_SCRIPT" stop 0
        ;;
    restart)
        "$CTRL_SCRIPT" restart 0
        ;;
    status)
        "$CTRL_SCRIPT" status
        ;;
    logs)
        echo -e "${BLUE}=========================================="
        echo "  AgriAI Core 실시간 로그"
        echo -e "==========================================${NC}"
        echo ""
        echo "Ctrl+C로 종료"
        echo ""
        sudo journalctl -u "$CORE_SERVICE" -f
        ;;
    enable)
        echo -e "${GREEN}AgriAI Core 자동 시작 활성화 중...${NC}"
        sudo systemctl enable "$CORE_SERVICE"
        echo -e "${GREEN}✓ 자동 시작 활성화 완료${NC}"
        ;;
    disable)
        echo -e "${YELLOW}AgriAI Core 자동 시작 비활성화 중...${NC}"
        sudo systemctl disable "$CORE_SERVICE"
        echo -e "${GREEN}✓ 자동 시작 비활성화 완료${NC}"
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo -e "${RED}오류: 알 수 없는 명령어 '$1'${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac
