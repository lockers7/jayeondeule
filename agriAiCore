# 서비스 번호에 따른 실행
execute_service() {
    local action="$1" num="$2"

    case "$num" in
        0) # ALL
            case "$action" in
                start)   all_start ;;
                stop)    all_stop ;;
                restart) all_restart ;;
                status)  show_status ;;
            esac
            ;;
        00) # APP (인프라 제외)
            case "$action" in
                start)   app_start ;;
                stop)    app_stop ;;
                restart) app_restart ;;
                status)  show_status ;;
            esac
            ;;
        1) # Ollama
            case "$action" in
                start)   ollama_start ;;
                stop)    ollama_stop ;;
                restart) ollama_restart ;;
                status)  printf "  Ollama: "; check_status "Ollama" port 11434 ;;
                logs)    journalctl -u ollama.service -n 100 --no-pager -f ;;
            esac
            ;;
        2) # PostgreSQL
            case "$action" in
                start)   postgresql_start ;;
                stop)    postgresql_stop ;;
                restart) postgresql_restart ;;
                status)  printf "  PostgreSQL: "; check_status "PostgreSQL" port 5432 ;;
                logs)    journalctl -u postgresql.service -n 100 --no-pager -f ;;
            esac
            ;;
        3) # ChromaDB
            case "$action" in
                start)   chromadb_start ;;
                stop)    chromadb_stop ;;
                restart) chromadb_restart ;;
                status)  printf "  ChromaDB: "; check_status "ChromaDB" port 8000 ;;
                logs)    journalctl -u chromadb.service -n 100 --no-pager -f ;;
            esac
            ;;
        4) # Scheduler
            case "$action" in
                start)   scheduler_start ;;
                stop)    scheduler_stop ;;
                restart) scheduler_restart ;;
                status)  printf "  Scheduler: "; check_status "Scheduler" pid_file "$SCHEDULER_PID" ;;
                logs)    tail -n 100 -f "$LOG_DIR/scheduler.log" ;;
            esac
            ;;
        5) # FastAPI
            case "$action" in
                start)   fastapi_start ;;
                stop)    fastapi_stop ;;
                restart) fastapi_restart ;;
                status)  printf "  FastAPI: "; check_status "FastAPI" port "${API_PORT:-8002}" ;;
                logs)    tail -n 100 -f "$LOG_DIR/api.log" ;;
            esac
            ;;
        6) # SearXNG
            case "$action" in
                start)   searxng_start ;;
                stop)    searxng_stop ;;
                restart) searxng_restart ;;
                status)  printf "  SearXNG: "; check_status "SearXNG" port 8888 ;;
                logs)    searxng_logs ;;
            esac
            ;;
        7) # Web Backend (Spring Boot - 농장관리)
            case "$action" in
                start)   springboot_start ;;
                stop)    springboot_stop ;;
                restart) springboot_restart ;;
                status)  printf "  Web Backend: "; check_status "Web Backend" port 9090 ;;
                logs)    journalctl -u jayeondeule_web.service -n 100 --no-pager -f ;;
            esac
            ;;
        8) # Shop Backend (Spring Boot - 쇼핑몰)
            case "$action" in
                start)   shop_start ;;
                stop)    shop_stop ;;
                restart) shop_restart ;;
                status)  printf "  Shop Backend: "; check_status "Shop Backend" port 9091 ;;
                logs)    tail -n 100 -f "$LOG_DIR/shop_backend.log" 2>/dev/null ;;
            esac
            ;;
        9) # Nginx
            case "$action" in
                start)   nginx_start ;;
                stop)    nginx_stop ;;
                restart) nginx_restart ;;
                status)  printf "  Nginx: "; check_status "Nginx" port 80 ;;
                logs)    journalctl -u nginx.service -n 100 --no-pager -f ;;
            esac
            ;;
        10) # Web Build (농장관리 React + Spring Boot)
            case "$action" in
                start|restart) web_build ;;
                stop)   log_msg "${YELLOW}[Web Build]${NC} 빌드 전용 서비스입니다 (stop 불필요)" ;;
                status) echo -e "  Web Build: ${YELLOW}● 빌드 전용${NC}" ;;
                logs)   tail -n 100 "$LOG_DIR/react_build.log" 2>/dev/null; tail -n 100 "$LOG_DIR/springboot_build.log" 2>/dev/null ;;
            esac
            ;;
        11) # Shop Build (쇼핑몰 React + Spring Boot)
            case "$action" in
                start|restart) shop_build ;;
                stop)   log_msg "${YELLOW}[Shop Build]${NC} 빌드 전용 서비스입니다 (stop 불필요)" ;;
                status) echo -e "  Shop Build: ${YELLOW}● 빌드 전용${NC}" ;;
                logs)   tail -n 100 "$LOG_DIR/shop_react_build.log" 2>/dev/null; tail -n 100 "$LOG_DIR/shop_build.log" 2>/dev/null ;;
            esac
            ;;
        12) # ALL Build (Web + Shop 전체 빌드)
            case "$action" in
                start|restart) all_build ;;
                stop)   log_msg "${YELLOW}[ALL Build]${NC} 빌드 전용 서비스입니다 (stop 불필요)" ;;
                status) echo -e "  ALL Build: ${YELLOW}● 빌드 전용${NC}" ;;
                logs)   tail -n 100 "$LOG_DIR/react_build.log" 2>/dev/null; tail -n 100 "$LOG_DIR/shop_react_build.log" 2>/dev/null ;;
            esac
            ;;
        *)
            echo -e "  ${RED}잘못된 번호입니다.${NC}"
            return 1
            ;;
    esac
}

