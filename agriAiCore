# agriAiCore.service(run_services.sh)가 실행 중이면 충돌 방지를 위해 중지
_stop_legacy_service() {
    if systemctl is-active --quiet "$CORE_SERVICE" 2>/dev/null; then
        log_msg "${YELLOW}[$CORE_SERVICE]${NC} 충돌 방지를 위해 중지..."
        sudo systemctl stop "$CORE_SERVICE" 2>/dev/null || true
        sleep 2
    fi
