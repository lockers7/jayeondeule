# --- Scheduler ---
scheduler_start() {
    log_msg "${BLUE}[Scheduler]${NC} 시작 중..."
    if [ -f "$SCHEDULER_PID" ]; then
        local pid
        pid=$(cat "$SCHEDULER_PID" 2>/dev/null)
        if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
            log_msg "${YELLOW}[Scheduler]${NC} 이미 실행 중 (PID $pid)"
            return 0
        fi
    fi
    pkill -f "agri_ai_core\.scheduler" 2>/dev/null || true
    sleep 1
    cd "$BASE_DIR"
    $PYTHON_BIN -m agri_ai_core.scheduler >> "$LOG_DIR/scheduler.log" 2>&1 &
    local pid=$!
    echo $pid > "$SCHEDULER_PID"
    log_msg "${GREEN}[Scheduler]${NC} 시작 완료 (PID $pid)"
}

scheduler_stop() {
    log_msg "${BLUE}[Scheduler]${NC} 종료 중..."
    if [ -f "$SCHEDULER_PID" ]; then
        local pid
        pid=$(cat "$SCHEDULER_PID" 2>/dev/null)
        if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
            if ! _safe_kill "$pid" "Scheduler"; then
                log_msg "${RED}[Scheduler]${NC} PID $pid 종료 실패 - PID 파일 유지"
                return 1
            fi
        fi
        rm -f "$SCHEDULER_PID"
    fi
    local remaining
    remaining=$(pgrep -f "agri_ai_core\.scheduler" 2>/dev/null || true)
    if [ -n "$remaining" ]; then
        for p in $remaining; do
            _safe_kill "$p" "Scheduler(잔존)" || true
        done
    fi
    log_msg "${GREEN}[Scheduler]${NC} 종료 완료"
}

scheduler_restart() {
    scheduler_stop
    sleep 1
    scheduler_start
}

