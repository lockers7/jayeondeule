# ─── 메인 ───

ACTION="${1:-}"
SERVICE_NUM="${2:-}"

case "$ACTION" in
    start|stop|restart|status|logs)
        ;;
    enable)
        echo -e "${GREEN}AgriAI Core 자동 시작 활성화 중...${NC}"
        sudo systemctl enable "$CORE_SERVICE"
        echo -e "${GREEN}자동 시작 활성화 완료${NC}"
        exit 0
        ;;
    disable)
        echo -e "${YELLOW}AgriAI Core 자동 시작 비활성화 중...${NC}"
        sudo systemctl disable "$CORE_SERVICE"
        echo -e "${GREEN}자동 시작 비활성화 완료${NC}"
        exit 0
        ;;
    help|--help|-h|"")
        print_header
        usage
        exit 0
        ;;
    *)
        echo -e "${RED}알 수 없는 명령: $ACTION${NC}"
        usage
        exit 1
        ;;
esac

# status는 번호 없이 전체 표시
if [ "$ACTION" = "status" ] && [ -z "$SERVICE_NUM" ]; then
    print_header
    show_status
    exit 0
fi

# logs는 번호 없이 전체 요약 표시
if [ "$ACTION" = "logs" ] && [ -z "$SERVICE_NUM" ]; then
    show_service_logs
    exit 0
fi

# 서비스 번호가 지정된 경우 바로 실행
if [ -n "$SERVICE_NUM" ]; then
    print_header
    execute_service "$ACTION" "$SERVICE_NUM"
    exit $?
fi

# 서비스 번호 미지정: 대화형 메뉴
print_header
show_status
show_menu

read -r choice

if [ "$choice" = "q" ] || [ "$choice" = "Q" ]; then
    echo "  종료합니다."
    exit 0
fi

if ! [[ "$choice" =~ ^[0-9]$ ]]; then
    echo -e "  ${RED}잘못된 입력입니다.${NC}"
    exit 1
fi

echo ""
execute_service "$ACTION" "$choice"
echo ""
