# ─── 서비스 로그 (systemctl status 3줄 요약) ───
show_service_logs() {
    print_header

    # systemd 서비스
    local svc
    for svc in ollama.service postgresql.service chromadb.service jayeondeule_web.service nginx.service; do
        SYSTEMD_COLORS=1 systemctl status "$svc" 2>/dev/null | head -3 | sed $'s/\x1b\]8;;[^\x07]*\x07//g'
        echo ""
    done

    # PID 기반 서비스 (Scheduler, FastAPI)
    local name pidfile pid etime
    for name in Scheduler FastAPI; do
        if [ "$name" = "Scheduler" ]; then pidfile="$SCHEDULER_PID"; else pidfile="$API_PID"; fi
        if [ -f "$pidfile" ]; then
            pid=$(cat "$pidfile" 2>/dev/null)
            if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
                etime=$(ps -p "$pid" -o etime= 2>/dev/null | xargs)
                echo -e "${GREEN}●${NC} $name (PID $pid)"
                echo "     Active: running (경과 ${etime:-알 수 없음})"
            else
                echo -e "${RED}○${NC} $name"
                echo "     Active: inactive (stale PID)"
            fi
        else
            echo -e "${RED}○${NC} $name"
            echo "     Active: inactive"
        fi
        echo ""
    done

    # Shop Backend (PID 기반)
    if [ -f "$SHOP_PID" ]; then
        pid=$(cat "$SHOP_PID" 2>/dev/null)
        if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
            etime=$(ps -p "$pid" -o etime= 2>/dev/null | xargs)
            echo -e "${GREEN}●${NC} Shop Backend (PID $pid)"
            echo "     Active: running (경과 ${etime:-알 수 없음})"
        else
            echo -e "${RED}○${NC} Shop Backend"
            echo "     Active: inactive (stale PID)"
        fi
    else
        echo -e "${RED}○${NC} Shop Backend"
        echo "     Active: inactive"
    fi
    echo ""

    # SearXNG (Docker)
    local searx_status
    searx_status=$(docker ps --filter "name=searxng" --format "{{.Status}}" 2>/dev/null)
    if [ -n "$searx_status" ]; then
        echo -e "${GREEN}●${NC} SearXNG (Docker)"
        echo "     Active: running ($searx_status)"
        docker logs searxng --tail 3 2>/dev/null | sed 's/^/             /'
    else
        local searx_exited
        searx_exited=$(docker ps -a --filter "name=searxng" --format "{{.Status}}" 2>/dev/null)
        echo -e "${RED}○${NC} SearXNG (Docker)"
        echo "     Active: inactive${searx_exited:+ ($searx_exited)}"
    fi
    echo ""
}

