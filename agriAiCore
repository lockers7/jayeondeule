# ────────────────────────────────────────────────────────────────────
# RPi 카메라 상태 — RPi 측 systemctl 상태 + 메인 측 :8095 헬스 양면 확인.
# ────────────────────────────────────────────────────────────────────
rpi_camera_status() {
    local rpi_state
    rpi_state=$(_rpi_cam_ssh "for s in $RPI_CAM_SVCS; do printf '%-25s ' \$s; systemctl is-active \$s; done" 2>/dev/null)
    if [ -n "$rpi_state" ]; then
        echo "  ──── RPi 측 서비스 ────"
        echo "$rpi_state" | sed 's/^/  /'
    else
        echo -e "  ${RED}● RPi SSH 응답 없음${NC} (network/SSH key)"
    fi
    echo "  ──── 메인 측 :$RPI_CAM_LOCAL_PORT 응답 ────"
    local body
    body=$(curl -s -m 5 "http://127.0.0.1:$RPI_CAM_LOCAL_PORT/health" 2>/dev/null)
    if [ "$body" = "OK" ]; then
        echo -e "  ${GREEN}● /health OK${NC} (USB 카메라 정상)"
    elif [ "$body" = "NO_CAMERA" ]; then
        echo -e "  ${YELLOW}● /health NO_CAMERA${NC} (RPi 에 USB 카메라 미인식)"
    else
        echo -e "  ${RED}● 응답 없음${NC} (reverse tunnel 미연결)"
    fi
    # 캡처 단발 테스트
    local t0 size
    t0=$(date +%s.%N)
    size=$(curl -s -m 10 -o /dev/null -w '%{size_download}' "http://127.0.0.1:$RPI_CAM_LOCAL_PORT/snapshot" 2>/dev/null)
    if [ -n "$size" ] && [ "$size" -gt 1000 ]; then
        local t1
        t1=$(date +%s.%N)
        local dt
        dt=$(awk -v a="$t1" -v b="$t0" 'BEGIN{printf "%.2f", a-b}')
        echo -e "  /snapshot 캡처: ${GREEN}${size} bytes${NC} (${dt}s)"
    fi
}

