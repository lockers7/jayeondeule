FROM python:3.10-slim

# Install minimal build deps, upgrade pip tooling, then install runtime packages
RUN set -eux \
    && apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev build-essential ca-certificates curl \
    && python -m pip install --upgrade pip setuptools wheel \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and constraints and install deterministically
COPY requirements.txt /tmp/requirements.txt
COPY constraints.txt /tmp/constraints.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r /tmp/requirements.txt --constraint /tmp/constraints.txt

# Remove build tools to reduce image size and attack surface
RUN set -eux \
    && apt-get purge -y --auto-remove gcc build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user for runtime
# Create a non-root user for runtime with host-matching UID to avoid volume perms issues
# UID 1000 is the common default for host users; aligns with bind-mounted dir ownership
RUN useradd --create-home --shell /bin/bash --uid 1000 appuser

# Ensure runtime data directory exists and is owned by runtime user
RUN mkdir -p /data && chown -R appuser:appuser /data /home/appuser

WORKDIR /home/appuser
USER appuser

COPY config.yaml /chroma/config.yaml
ENV CHROMA_CONFIG_FILE=/chroma/config.yaml

EXPOSE 8000

CMD ["uvicorn", "chromadb.app:app", "--host", "0.0.0.0", "--port", "8000"]
